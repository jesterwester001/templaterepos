a[href$="CAVEID"]>div.cave-grid>img {
content: url('IMG LINK')!important;
width: 258px !important;
height: auto !important; }
a[href$="CAVEID"]>div.cave-grid>img {
content: url('IMG LINK')!important; 
width: 258px !important;
height: auto !important; }
a[href$="CAVEID"]>div.cave-grid>img {
content: url('IMG LINK')!important;
width: 258px !important;
height: auto !important; }


div.cave-grid>img[src$="nestingbanner.png"] {
	content: url('IMG LINK')!important; }
a[href$="unsorted.php?id=USERID"]>div.cave-grid>img{
content: url('IMG LINK')!important;
width: 75px;
height: 75px;}
a[href*="lionoverview.php?id=USERID"]>div.cave-grid>img {
content: url('IMG LINK')!important;
width: 75px;
height: 75px; }

a[href$="unsorted-beetles.php?id=USERID"] img {
content:url('IMG LINK') !important;
background-size: cover;
width: 100%;
height: auto; } 

a[href$="mound.php?id=MOUNDID"] img {
content:url('IMG LINK') !important;
background-size: cover;
width: 100%;
height: auto; } 

/* CAVE COMPATIBILITY
featured-lion changes the colors behind your featured lion, literally the strip of text where 
it says 'featured lion: NAME'
the image src cave default changes the image behind your lion. it will not make them display decor.

table#pride.table controls where your lions names are shown. we're only giving a color value
here, but you can also edit the background by adding in a background value.
the a, and a:visited values are for links. this will make your lions names be the same color as whatever
color you set for the text
table#pride.table .xsmall just puts the lion subtext back to its regular size, since we edited all
.xsmalls earlier when fixing FAPA. you can remove this if you want the bigger text. */

.featured-lion {
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important;
padding: 0;
margin: 0 auto;
max-width: 640px;
font-weight: bold;
font-size: 14px; }

img[src*="cave/default"] {
content: url('IMG LINK') !important;}

table#pride.table, table#pride.table a, table#pride.table a:visited {
color: #HEX !important; }

table#pride.table .xsmall
{font-size: 12px !important;}
	
/ * NO LINK UNDERLINE - This removes Link underlines at the links at the bottom of the page,
and removes link underlines from edit your details */
		
.footer a:link, .footer a:visited, .footer a:active {
border-bottom: none !important; }

td.bottom a, th a {
border-bottom: none !important; }

/* BOXES
do not give the box container a background.
Box1, Box2, & Box3 can be repeated as many times as possible, just make sure you properly close them.
box html should look like this
<div class="boxcontainer"><div class="Box1">text</div></div>
<div class="boxcontainer"><div class="Box3">text</div><div class="Box2">text</div></div> */

.boxcontainer {
background: none;
height: 75px;
padding: 0px;
display: block;
justify-content: center;
transition: 1s }
.boxcontainer:hover {
height: 250px; }
   
.Box1 {
float: left;
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important;
padding: 5px;
float: left;
height: 75px;
width: 100%;
overflow: hidden;
margin-bottom: 10px;
transition: 1s }   
.Box1:hover {
overflow-y: auto;
height: 250px; }
   
.Box2 {
float: right;
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important;
padding: 5px;
float: right;
height: 75px;
width: 30%;
overflow: hidden;
margin-bottom: 10px;
transition: 1s }   
.Box2:hover {
overflow-y: auto;
height: 250px; }
	
.Box3 {
float: right;
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important;
padding: 5px;
float: right;
height: 75px;
width: 65%;
overflow: hidden;
margin-bottom: 10px;
transition: 1s }   
.Box3:hover {
overflow-y: auto;
height: 250px; }
	
