/* FONTS - Import from Google Fonts */
 
@import url('FONT LINK');
 
body {font-family: INPUT HERE;}
 
.topbar {font-family: INPUT HERE;}
 
.navbar {font-family: INPUT HERE;}

/* BACKGROUNDS 
The first one is for PC, the second is for mobile. You can also use an image in the second one
via replacing #HEX with url('IMG LINK') center center fixed;
BUT I recommend repeating patterns rather than full images. */
 
@media screen and (min-width: 601px) { 
body {
background: url('IMG LINK') center center fixed;
background-size: 100%;
color: #HEX; } }

@media screen and (max-width: 600px){
body {
background: #HEX;
background-size: cover;
color: #HEX; } }

/* SCROLL BOXES */
 
::-webkit-scrollbar {
width: 7px;
height: 7px; }
::-webkit-scrollbar-track {
background: #HEX;}
::-webkit-scrollbar-thumb {
background: #HEX; } 
/* first number is thumb, second is track, firefox only */
:root {
scrollbar-color: #3E3D1E #A28E6B !important;
scrollbar-width: auto;}
 
/* HEADERS -
H1 is the big header that says 'X's Den'
H2 is not used anywhere in the default look unless you want to use it.
H3 is used in the side bar (above the energy panel, achievement panel, etc. */
 
h1 {
color: #HEX !important;
font-size: 64px;
text-align: center !important;}

h2 {
color: #HEX !important;
font-size: 24px;}

h3 {
color: #HEX !important;
font-size: 18px;}
 
/* LINKS
Color of links. This will affect all links on your page.
Plan accordingly. */
 
a:link,
a:visited {
color: #HEX !important;
background: none !important; }
   
a:hover {
color: #HEX !important; }
 
/* MAIN PANEL - The panel in front of your background image. Usually a solid color on Lioden.
You can make it a solid color by either using a HEX code, or by setting the final number in RGBA to 1.0 */
   
.container.main {
background: rgba(55, 58, 39, 0.0);
border: none;
box-shadow: none;
border-radius: 5px; }
.col-md-9 {
background: none; } 
 
/* TOPBAR, NAVBAR, & BREADCRUMB 
.topbar is the bar that shows your currency, your inbox, etc.
.badge is the little icon that displays how many messages you have to read,
and how many days a lioness has left until heat in caves
.navbar is the bar that says "Den", "Crossroads", etc.
.navbar li a:hover affects when you hover over a section of your navbar  */
 
.topbar {
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important;  }

.badge {
background: #HEX !important;
color: #HEX !important; }
 
.navbar {
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important; }

.navbar li a:hover {
background: #HEX !important;
color: #e4a574 !important; }

/* This is mobile collapable navbar color changes.
toggle is the button that opens the navbar
leave .navbar-toggle background set to #HEX to have it inherit the color of the navbar
navbar-collapse is just there to hide the white line 
*/

.navbar-toggle {
border: none !important;
background: #HEX !important; }

.navbar-collapse {
box-shadow: none !important;
border-top: none !important; }

 
/* Bookmark Bar - aka breadcrumb, this is where your link path is shown */

.breadcrumb {
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important;} 
.breadcrumb .active {
color: #HEX; }
 
/* ALERTS 
.alert is all alerts, only set this one if you want all alerts to be the same color
.alert-success is the green one you see for hunting, patrolling, etc.
.alert-danger is red alerts, like inbox
.alert-warning is also some other red alerts, but I can't remember which ones. keep this
and danger the same color for best results
(quick notice maybe? more research)*/
 
.alert {
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important;
text-align: center !important;  }
.alert-warning {
background: #HEX !important;
color: #HEX !important;}
.alert-danger {
background: #HEX !important;
color: #HEX !important;}
.alert-success {
background: #HEX !important;
color: #HEX !important;}
 

/*COMMENT BOX 
This is a complicated one. please read carefully
div#CommentBox is the color of the ENTIRE BOX, without comments in it. it is also the container
.comment is the COMMENTS THEMSELVES
If you want the flippy floppy colors, where one is a little darker than the other, DO NOT FILL IN ANYTHING FOR
.comment ONLY FILL IN div#commentBox

.input.bad is the icon to delete comments. you will be the only one to see this
.input.bad a is the color of the x inside of it
*/

div#commentBox {
background: #HEX !important;
border: none !important;
border-radius: 0px !important;
color: #HEX !important;}
	
.comment {     
background: #HEX !important;
border: none !important;
border-bottom: none !important;
border-radius: 0px !important;
color: #HEX !important;
text-align: center !important;}
.text-muted { 
color: #HEX !important; }

input.bad {
background: #HEX !important;
color: #HEX !important;}
input.bad a {
color: #HEX !important; }

table#player.table hr {
display: none !important; }
table#player.table div.xlarge { 
margin-top: 10px !important; }

 
/* SIDE PANELS 

These are the panels that contain the actual information
on the right side of your page, so where your exp, impression, etc. bars
are contained, where your event currency is displayed, etc. */
 
.panel {
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important;
box-shadow: none !important;  }
   
/*IMPRESSION / ALL PROGRESS Bars
Unless you color the progress bars below, all progress bars will default
to the colors you put here.
Bars will also inherit the border-radius value from this one, so it's
not needed to specify border-radius for all bars. */
.progress-bar {
background: #HEX !important; 
border-radius: 0px !important; }

/* ENERGY */ .progress-bar-warning { 
background: #HEX !important;
color: #HEX !important;}
/* HUNGER */ .progress-bar-danger { 
background: #HEX !important;
color: #HEX !important;}
/* EXP + ACHIEVEMENTS */ .progress-bar-success { 
background: #HEX !important;
color: #HEX !important;}

/* This is the text that reads Energy: X% */
.progress div {
color: #HEX !important; }

/* This is the background of the progress bars, aka the empty part. */
.progress {
background:  #HEX;
color: #HEX !important;
border-radius: 0px !important;  }
 
/* CHAT 
i had to change this due to issues.
.s-chat-message controls backgrounds of chat, both even and odd, odd is the first
.s-chat-message_mention controls when you get pinged.
.s-chat-message__pinned is the pinned message
s-chat-message_timestamp is the text that says how recently a message was posted
*/
 
.s-chat-message:nth-child(even) {
    background: #HEX !important;
    border: none !important; }
.s-chat-message:nth-child(odd) {
background-color: #HEX !important; }
.s-chat-message__pinned {
    background: #HEX !important;
    color: #HEX !important;
    border: none !important; }
.s-chat-message_timestamp {
    color: #HEX !important; }

	#chatMessageList[data-pings="enabled"] .s-chat-message_mention {
		background-color: #HEX !important;
		border-left: 6px solid #HEX !important;
		color: #HEX !important;
		border-top-right-radius: 5px !important;
		border-bottom-right-radius: 5px !important;
	}
.s-chat-message.s-chat-message_mention a, .s-chat-message.s-chat-message_mention a:visited {
color: #HEX !important; }
   
div#chatMessageContainer {
    border: none !important; }
button#label_currentChannel {
    background: #HEX !important;
    color: #HEX !important;
border: none !important;
border-radius: 5px !important; }

div#lblCharacterCounter {
color: #HEX !important; }

.s-chat-sidebar #fraChatChannelMenu,
button.channelSwitcher, button.channelSwitcher.active {
    background: #HEX !important;
    color: #HEX !important;
border: none !important;
border-radius: 5px !important;
box-shadow: none !important; }


#fra_chatContainer .channelMenu .channelSwitcher:hover {
		background: #HEX;}
html.nolayout {
background: none !important; }

/* Emote List
Keep border-top on div.emoteList.active::before as none, otherwise you'll
have a super weird gap between the emotelist and the little triangle*/

div.emoteList.active {
  background: #HEX !important;
  border: 1px solid #HEX !important;
  box-shadow: none !important;
}
div.emoteList.active::before {
background: #HEX
border-top: none !important;
border: 1px solid #HEX !important; }


/* FAPA, KING DYNASTY, ETC.
The .xsmall makes it where FAPA boxes are the same length.
div.left controls BOTH the dynasty, achievements, showcase, beetle book AND
view breeding requests, view user log, and view attack history buttons */
 
.feature {
background: #HEX !important;
color: #HEX !important;
border: 3px double #HEX !important;
border-radius: 0px !important;  }

div.left {
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important; }

.xsmall {
font-size: 14px !important; }
 
/* LION INFO 
Table - the background behind your table. You can make this a solid color by replacing
rgba(0, 0, 0, 0.0) with a HEX code, or by replacing the 0.0 with a 1.0 */
 
.table {
background: rgba(0, 0, 0, 0.0);
border: none !important;
border-collapse: separate;
border-radius: 0px; }

/* .top is where your king's name is displayed
.bottom is where your number of mutations within your pride is displayed
th is every other header on your den, like sparring table, reclaim left lions,
edit details, etc. */

.top, .bottom, th {
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important; }

/* table.left will be used by the sections on the left of the edit your details panel once open
.inner-table .left is used by the table that displays the names of the sections of
info about your den, like your territory, your king's stats, etc. 
.inner-table .right is used by the boxes next to the king's info, that displays the actual info. */
 
.table .left {
background: #HEX;
border-radius: 0px !important; }

.inner-table .left {
background: #HEX !important;
border-radius: 0px !important;  }

.inner-table .right {
background: #HEX !important;
border-radius: 0px !important; 
color: #HEX !important; } 

.right_odd {
background: none !important; }

/* LION AND USER AVATAR OPACITY */
   
div#lion_image {
opacity: 1.0;
border-radius: 50%;
overflow: hidden; }   
table#player img {
opacity: 1.0;
border-radius: 50%; }

/* LIODEN LOGO REPLACER - You can use any image, but the 192x120 size works best.
otherwise it can make your navbar look weird.
192x120 */
   
div.container.main>div:nth-child(1)>nav>div.navbar-header>a>img {
display: none;}
div.container.main>div:nth-child(1)>nav>div.navbar-header>a::after {
content: url('IMG LINK'); }
 
/* TEXT BOXES & BUTTONS -
all text boxes and buttons will be whatever color you put in here
you can separate them, just by copy and pasting names and the css code behind it
for example, for input to be red while everything else is white, it would look like this
input {background: red !important;}
textarea, select, button.button, a.btn.btn-default.button {background: white !important;} */
 
input, textarea, select, button.button,
a.btn.btn-default.button {
background: #HEX !important;
border: none !important;
border-radius: 0px !important;
color: #HEX !important;
text-shadow: none !important; }
 
/* CAVE NAMES - changes the color of of where cave names are displayed */
 
.cave-grid,
.mound-grid {
background: #HEX !important;
color: #HEX !important;
border: none !important;
border-radius: 0px !important; }

/* CAVE & MOUND COVERS
width: 240
height: 120 (60 for half size - like the nesting banner)
first one controls all cave slots - even empty ones.
If you want big cave icons (like the ones here: https://images2.imgbox.com/26/21/3qjfGg8U_o.png), simply use a lioden
bg or an image equal in size (640x500) 
you can change the sizes on the nesting, unsorted, etc, to be the same as the other sizes, as well.
beetle mounds are 130x80px 
you can copy and paste for more caves or mounds than what's provided
*/

div.cave-grid>img {
